# Copia questo file in .env e compila i valori (NON caricare .env su GitHub)
ADMIN_PIN=metti-qui-il-tuo-pin
STRIPE_SECRET_KEY=sk_test_...
# Opzionale ma consigliato in produzione:
STRIPE_WEBHOOK_SECRET=whsec_...
# L'indirizzo pubblico del sito (serve per i link di pagamento)
BASE_URL=http://localhost:3000
CURRENCY=eur
# Prezzo standard in euro (mostrato sul sito e proposto nei nuovi ordini)
PREZZO=990
# Prezzo del pacchetto Premium (dominio personalizzato + QR code)
PREZZO_PREMIUM=1490
# Abbonamento del sito: canone al mese (euro) e mesi di vincolo
CANONE_BASE=59
CANONE_PREMIUM=99
VINCOLO_MESI=24
PORT=3000
# Numero WhatsApp Business per il pulsante "Scrivici" (solo cifre, con prefisso)
WHATSAPP=27710933377
# Mostrati al cliente SOLO dopo il pagamento, con le istruzioni del pannello
PIN_SITO=123456
TOKEN_SITO=github_pat_...
# Facoltativo: chiavi delle fonti per Trova clienti (meglio incollarle nella pagina /collegamenti)
GOOGLE_PLACES_KEY=
HERE_API_KEY=
TOMTOM_API_KEY=
# Assistenza facoltativa, in euro al mese (senza vincolo)
CANONE_ASSISTENZA=20

# Facoltativo: un tuo Payment Link per l'assistenza (altrimenti lo crea il sito da solo)
ASSISTENZA_LINK=
