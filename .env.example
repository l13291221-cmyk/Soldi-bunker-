# Copia questo file in .env e compila i valori (NON caricare .env su GitHub)
ADMIN_PIN=metti-qui-il-tuo-pin
STRIPE_SECRET_KEY=sk_test_...
# Opzionale ma consigliato in produzione:
STRIPE_WEBHOOK_SECRET=whsec_...
# L'indirizzo pubblico del sito (serve per i link di pagamento)
BASE_URL=http://localhost:3000
CURRENCY=eur
# Prezzo standard in euro (mostrato sul sito e proposto nei nuovi ordini)
PREZZO=990
# Prezzo del pacchetto Premium (dominio personalizzato + QR code)
PREZZO_PREMIUM=1490
PORT=3000
# Numero WhatsApp Business per il pulsante "Scrivici" (solo cifre, con prefisso)
WHATSAPP=27710933377
# Mostrati al cliente SOLO dopo il pagamento, con le istruzioni del pannello
PIN_SITO=123456
TOKEN_SITO=github_pat_...
# Facoltativo: chiave Google (Places API New) per cercare clienti anche su Google Maps
GOOGLE_PLACES_KEY=
# Pacchetti in abbonamento (attivazione una tantum + canone mensile, vincolo minimo in mesi)
ATTIVAZIONE_BASE=290
CANONE_BASE=39
ATTIVAZIONE_PREMIUM=390
CANONE_PREMIUM=59
VINCOLO_MESI=12
